# PocketBase Cloud Configuration (Self-Hosted on Oracle Ubuntu)
# เมื่อชี้โดเมนและต่อ Nginx แล้ว ให้ใส่ URL ของโดเมนคุณ (HTTPS)
# ตัวอย่าง: https://memokard.yourdomain.com หรือ https://yourdomain.com
VITE_POCKETBASE_URL=https://YOUR_DOMAIN.COM

# ถ้าทดสอบรันบนเครื่อง Local ให้ใช้:
# VITE_POCKETBASE_URL=http://127.0.0.1:8090

# (ตัวเลือกเสริม: หากต้องการใช้ Supabase แบบเดิม)
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# VITE_ADMIN_USER_ID=your-admin-user-id
